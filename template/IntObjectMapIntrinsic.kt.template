            override fun remove(element: Int): Boolean = parent.remove(element)

            override fun retainAll(elements: Collection<Int>): Boolean {
                val toRemove = ArrayList<Int>()
                forEach { key ->
                    if (key !in elements) toRemove.add(key)
                }
                toRemove.forEach { parent.remove(it) }
                return toRemove.isNotEmpty()
            }

            override fun removeAll(elements: Collection<Int>): Boolean {
                var result = false
                elements.forEach { element ->
                    if (parent.remove(element)) result = true
                }
                return result
            }
        }

    override val values: MutableCollection<V>
        get() = object : MutableCollection<V> {
            override val size: Int
                get() = parent.size

            override fun isEmpty(): Boolean = parent.isEmpty()

            override fun iterator(): MutableIterator<V> {
                return object : MutableIterator<V> {
                    private var index = 0
                    private var nextIndex = -1
                    private var done = false
                    private var canRemove = false

                    private fun findNext() {
                        while (index < parent.capacity && !done) {
                            if (isFull(parent.metadata, index)) {
                                nextIndex = index
                                index++
                                canRemove = true
                                return
                            }
                            index++
                        }
                        done = true
                        canRemove = false
                    }

                    init {
                        findNext()
                    }

                    override fun hasNext(): Boolean = !done

                    @Suppress("UNCHECKED_CAST")
                    override fun next(): V {
                        if (!hasNext()) throw NoSuchElementException()
                        canRemove = false
                        val result = parent.values[nextIndex] as V
                        findNext()
                        return result
                    }

                    override fun remove() {
                        if (!canRemove) throw IllegalStateException()
                        parent.remove(parent.keys[nextIndex])
                        canRemove = false
                    }
                }
            }

            override fun add(element: V): Boolean = throw UnsupportedOperationException()

            override fun addAll(elements: Collection<V>): Boolean = throw UnsupportedOperationException()

            override fun clear() = parent.clear()

            override fun remove(element: V): Boolean {
                val keys = parent.keys
                val values = parent.values
                for (i in 0 until parent.capacity) {
                    if (isFull(parent.metadata, i)) {
                        @Suppress("UNCHECKED_CAST")
                        if (values[i] == element) {
                            parent.remove(keys[i])
                            return true
                        }
                    }
                }
                return false
            }

            override fun retainAll(elements: Collection<V>): Boolean {
                val toRemove = ArrayList<Int>()
                parent.forEach { key, value ->
                    if (value !in elements) toRemove.add(key)
                }
                toRemove.forEach { parent.remove(it) }
                return toRemove.isNotEmpty()
            }

            override fun removeAll(elements: Collection<V>): Boolean {
                val toRemove = ArrayList<Int>()
                parent.forEach { key, value ->
                    if (value in elements) toRemove.add(key)
                }
                toRemove.forEach { parent.remove(it) }
                return toRemove.isNotEmpty()
            }

            override fun contains(element: V): Boolean {
                parent.forEach { _, value ->
                    if (value == element) return true
                }
                return false
            }

            override fun containsAll(elements: Collection<V>): Boolean {
                elements.forEach { element ->
                    if (!contains(element)) return false
                }
                return true
            }
        }
